{
  "version": "1",
  "methods": {
    "prepare": {
      "mode": "unary",
      "input": {
        "type": "object",
        "properties": {
          "lines": {
            "type": "array",
            "items": {
              "type": "string",
              "maxLength": 256
            },
            "maxItems": 1000
          },
          "delay_ms": {
            "type": "integer",
            "minimum": 0,
            "maximum": 1000
          }
        },
        "required": [
          "lines"
        ],
        "additionalProperties": false
      },
      "output": {
        "type": "object",
        "properties": {
          "records": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "service": {
                  "type": "string",
                  "maxLength": 32
                },
                "status": {
                  "type": "integer",
                  "minimum": 100,
                  "maximum": 599
                },
                "duration_ms": {
                  "type": "integer",
                  "minimum": 0,
                  "maximum": 60000
                }
              },
              "required": [
                "service",
                "status",
                "duration_ms"
              ],
              "additionalProperties": false
            },
            "maxItems": 1000
          },
          "rejected": {
            "type": "integer",
            "minimum": 0,
            "maximum": 1000
          },
          "reasons": {
            "type": "array",
            "items": {
              "type": "string",
              "maxLength": 128
            },
            "maxItems": 1000
          }
        },
        "required": [
          "records",
          "rejected",
          "reasons"
        ],
        "additionalProperties": false
      },
      "error": {
        "type": "object",
        "properties": {
          "reason": {
            "type": "string",
            "maxLength": 128
          }
        },
        "required": [
          "reason"
        ],
        "additionalProperties": false
      }
    },
    "render": {
      "mode": "unary",
      "input": {
        "type": "object",
        "properties": {
          "processed": {
            "type": "integer",
            "minimum": 0,
            "maximum": 1000
          },
          "total": {
            "type": "integer",
            "minimum": 0,
            "maximum": 1000
          },
          "error_count": {
            "type": "integer",
            "minimum": 0,
            "maximum": 1000
          },
          "slow_count": {
            "type": "integer",
            "minimum": 0,
            "maximum": 1000
          },
          "total_duration_ms": {
            "type": "integer",
            "minimum": 0,
            "maximum": 60000000
          },
          "p95_ms": {
            "type": "integer",
            "minimum": 0,
            "maximum": 60000
          }
        },
        "required": [
          "processed",
          "total",
          "error_count",
          "slow_count",
          "total_duration_ms",
          "p95_ms"
        ],
        "additionalProperties": false
      },
      "output": {
        "type": "object",
        "properties": {
          "text": {
            "type": "string",
            "maxLength": 1024
          }
        },
        "required": [
          "text"
        ],
        "additionalProperties": false
      },
      "error": {
        "type": "object",
        "properties": {
          "reason": {
            "type": "string",
            "maxLength": 128
          }
        },
        "required": [
          "reason"
        ],
        "additionalProperties": false
      }
    }
  }
}
