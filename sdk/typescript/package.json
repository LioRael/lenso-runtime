  "scripts": {
    "build": "bun build index.ts schema.ts generate.ts --outdir dist --target bun --packages external --splitting && tsc -p tsconfig.build.json",
    "test": "bun run build && bun test ."
  },
  "dependencies": {
    "ws": "^8.18.3"
  },
  "devDependencies": {
    "@types/ws": "^8.18.1"
  }
