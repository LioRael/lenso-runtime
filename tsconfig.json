{
  "compilerOptions": {
    "target": "ES2022",
    "module": "Preserve",
    "moduleResolution": "Bundler",
    "strict": true,
    "noEmit": true,
    "allowImportingTsExtensions": true,
    "skipLibCheck": true,
    "types": ["bun"]
  },
  "include": [
    "sdk/typescript/**/*.ts",
    "tools/**/*.ts",
    "scripts/**/*.ts",
    "examples/generated/*.ts"
  ]
}
